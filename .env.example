# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Adresy i parametry urządzeń NIE są tutaj – są w config/devices.yaml.
# Hasła generuje komputer (openssl rand -hex 24); procedura: docs/ops/jumo-ipc-setup.md.
# Nie generuj .env od nowa przy istniejącym wolumenie bazy (hasło postgres działa tylko przy pierwszym starcie).

# Ogólne (strefa kontenerów; baza zawsze w UTC)
TZ=Europe/Warsaw

# TimescaleDB
POSTGRES_DB=energy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_WRITER_PASSWORD=
APP_READER_PASSWORD=

# Grafana (używane od kroku k7)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# MQTT (Mosquitto): osobne konta, najmniejsze uprawnienia (ACL w config/mosquitto/acl.conf)
MQTT_COLLECTOR_USER=collector
MQTT_COLLECTOR_PASSWORD=
MQTT_INGEST_USER=ingest
MQTT_INGEST_PASSWORD=

# Czat AI (etap 6)
OLLAMA_MODEL=qwen2.5:3b
CHAT_SQL_TIMEOUT_MS=5000

# Model w chmurze – domyślnie wyłączony (etap 6)
CLOUD_LLM_ENABLED=false
CLOUD_LLM_PROVIDER=
CLOUD_LLM_API_KEY=
