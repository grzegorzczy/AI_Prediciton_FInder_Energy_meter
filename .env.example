# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Adresy i parametry urządzeń NIE są tutaj – są w config/devices.yaml.

# Ogólne
TZ=Europe/Warsaw

# TimescaleDB
POSTGRES_DB=energy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_WRITER_PASSWORD=
APP_READER_PASSWORD=

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# MQTT (Mosquitto)
MQTT_USER=
MQTT_PASSWORD=

# Czat AI
OLLAMA_MODEL=qwen2.5:3b
CHAT_SQL_TIMEOUT_MS=5000

# Model w chmurze – domyślnie wyłączony (etap 6)
CLOUD_LLM_ENABLED=false
CLOUD_LLM_PROVIDER=
CLOUD_LLM_API_KEY=
