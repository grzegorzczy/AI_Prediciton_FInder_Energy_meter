      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aip-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(bucket, $__interval), (sum(reactive_power_sum) / nullif(sum(reactive_power_n), 0)) / nullif(sum(active_power_sum) / nullif(sum(active_power_n), 0), 0) AS \"Q/P\" FROM energy_1m WHERE $__timeFilter(bucket) AND device_id = '$device' GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Stosunek mocy biernej do czynnej (Q/P)",
      "type": "timeseries"
