        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aip-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT make_interval(secs => greatest($__interval_ms / 1000.0, 60)) AS step), b AS (SELECT generate_series(time_bucket(s.step, $__timeFrom()::timestamptz), $__timeTo()::timestamptz, s.step) AS t FROM s), a AS (SELECT time_bucket(s.step, bucket) AS t, device_id, sum(active_power_n) AS n FROM energy_1m, s WHERE $__timeFilter(bucket) GROUP BY 1, 2) SELECT b.t AS time, d.name || CASE WHEN d.source = 'sim' THEN ' (SYMULACJA)' ELSE '' END AS metric, CASE WHEN coalesce(a.n, 0) * (d.meta ->> 'poll_interval_s')::float8 >= 0.95 * extract(epoch FROM least(now(), b.t + s.step) - b.t) THEN 2 WHEN coalesce(a.n, 0) > 0 THEN 1 ELSE 0 END AS value FROM b CROSS JOIN s CROSS JOIN devices d LEFT JOIN a ON a.t = b.t AND a.device_id = d.device_id WHERE d.kind = 'energy_meter' AND d.enabled AND b.t <= now() ORDER BY 1, 2",
          "refId": "A"
        }
      ],
      "title": "Świeżość danych w czasie",
      "type": "state-timeline"
    }
