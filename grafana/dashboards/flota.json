          "editorMode": "code",
          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(e.bucket, $__interval), d.name || CASE WHEN d.source = 'sim' THEN ' (SYMULACJA)' ELSE '' END AS metric, sum(e.active_power_sum) / nullif(sum(e.active_power_n), 0) AS value FROM energy_1m e JOIN devices d USING (device_id) WHERE $__timeFilter(e.bucket) AND d.kind = 'energy_meter' AND d.enabled GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Moc czynna – flota",
