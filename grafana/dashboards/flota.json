      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aip-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT label AS \"Urządzenie\", src AS \"Źródło\", CASE WHEN last IS NULL OR now() - last > make_interval(secs => $stale_s) THEN 'Brak danych' ELSE 'Aktualne' END AS \"Stan\", extract(epoch FROM now() - last) AS \"Wiek odczytu\", p AS \"Moc teraz\", e AS \"Energia od północy\" FROM (SELECT d.source, d.name || CASE WHEN d.source = 'sim' THEN ' (SYMULACJA)' ELSE '' END AS label, CASE WHEN d.source = 'sim' THEN 'SYMULACJA' ELSE 'pomiar' END AS src, (SELECT max(time) FROM measurements m WHERE m.device_id = d.device_id AND m.metric = 'active_power' AND m.time > now() - interval '1 hour') AS last, (SELECT value FROM measurements m WHERE m.device_id = d.device_id AND m.metric = 'active_power' AND m.time > now() - make_interval(secs => $stale_s) ORDER BY m.time DESC LIMIT 1) AS p, (SELECT c.integral_wh / 1000.0 FROM energy_daily_check c WHERE c.device_id = d.device_id AND c.day = (now() AT TIME ZONE 'Europe/Warsaw')::date) AS e FROM devices d WHERE d.kind = 'energy_meter' AND d.enabled) f ORDER BY source = 'sim', label",
          "refId": "A"
        }
      ],
      "title": "Liczniki floty",
      "type": "table"
    },
