          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT day AS \"Doba\", integral_wh AS \"Całka [Wh]\", coverage AS \"Pokrycie\", counter_delta_wh AS \"Przyrost licznika [Wh]\", integral_extrapolated_wh AS \"Całka uzupełniona do doby [Wh]\", diff_wh AS \"Różnica [Wh]\", resolution_wh AS \"Rozdzielczość [Wh]\", within_resolution AS \"W granicach rozdzielczości\", deviation_pct AS \"Odchyłka [%]\", day_complete AS \"Doba zakończona\", gap_before_count AS \"Godziny po luce\" FROM energy_daily_check WHERE device_id = '$device' AND day::timestamp AT TIME ZONE 'Europe/Warsaw' BETWEEN $__timeFrom() - interval '1 day' AND $__timeTo() ORDER BY day DESC",
          "refId": "A"
        }
      ],
      "title": "Kontrola całki mocy a licznik wzorcowy (doby)",
      "type": "table"
