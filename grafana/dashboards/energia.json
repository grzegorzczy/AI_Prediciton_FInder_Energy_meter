          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT hour AS \"Godzina\", avg(w) FILTER (WHERE dow = 1) AS \"Pon\", avg(w) FILTER (WHERE dow = 2) AS \"Wt\", avg(w) FILTER (WHERE dow = 3) AS \"Śr\", avg(w) FILTER (WHERE dow = 4) AS \"Czw\", avg(w) FILTER (WHERE dow = 5) AS \"Pt\", avg(w) FILTER (WHERE dow = 6) AS \"Sob\", avg(w) FILTER (WHERE dow = 7) AS \"Niedz\" FROM (SELECT extract(hour FROM bucket AT TIME ZONE 'Europe/Warsaw')::int AS hour, extract(isodow FROM bucket AT TIME ZONE 'Europe/Warsaw')::int AS dow, active_power_sum / nullif(active_power_n, 0) AS w FROM energy_1h WHERE $__timeFilter(bucket) AND device_id = '$device') s GROUP BY hour ORDER BY hour",
          "refId": "A"
        }
      ],
      "title": "Profil: godzina × dzień tygodnia (średnia moc)",
