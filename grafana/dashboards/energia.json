          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT (bucket AT TIME ZONE 'Europe/Warsaw')::date::timestamp AT TIME ZONE 'Europe/Warsaw' AS time, percentile_cont(0.05) WITHIN GROUP (ORDER BY active_power_sum / active_power_n) AS \"Moc bazowa\" FROM energy_1m WHERE $__timeFilter(bucket) AND device_id = '$device' AND active_power_n > 0 AND extract(hour FROM bucket AT TIME ZONE 'Europe/Warsaw') < 5 GROUP BY 1 ORDER BY 1",
