            "uid": "aip-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, active_power_sum * (SELECT (meta ->> 'poll_interval_s')::float8 FROM devices WHERE device_id = '$device') / 3600.0 AS \"Energia [Wh]\", least(1.0, active_power_n * (SELECT (meta ->> 'poll_interval_s')::float8 FROM devices WHERE device_id = '$device') / 60.0) AS \"Pokrycie\" FROM energy_1m WHERE $__timeFilter(bucket) AND device_id = '$device' AND ($__timeTo() - $__timeFrom()) <= interval '7 days' ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Zużycie na minutę",
      "type": "timeseries"
