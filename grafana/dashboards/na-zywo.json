            "uid": "aip-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT CASE metric WHEN 'voltage' THEN 'Napięcie U [V]' WHEN 'current' THEN 'Prąd I [A]' WHEN 'active_power' THEN 'Moc czynna P [W]' WHEN 'reactive_power' THEN 'Moc bierna Q [var]' WHEN 'apparent_power' THEN 'Moc pozorna S [VA]' WHEN 'power_factor' THEN 'PF' WHEN 'frequency' THEN 'Częstotliwość f [Hz]' WHEN 'thd_voltage' THEN 'THD U [%]' WHEN 'thd_current' THEN 'THD I [%]' WHEN 'phase_angle' THEN 'Kąt U–I [°]' ELSE 'Temperatura [°C]' END AS \"Wielkość\", last(value, time) AS \"Ostatnia\", min(value) AS \"Min\", max(value) AS \"Maks\", avg(value) AS \"Średnia\" FROM measurements WHERE $__timeFilter(time) AND device_id = '$device' AND metric IN ('voltage','current','active_power','reactive_power','apparent_power','power_factor','frequency','thd_voltage','thd_current','phase_angle','meter_temperature') GROUP BY metric ORDER BY 1",
