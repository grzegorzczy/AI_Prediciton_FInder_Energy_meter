      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aip-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT CASE metric WHEN 'voltage' THEN 'Napięcie U [V]' WHEN 'current' THEN 'Prąd I [A]' WHEN 'active_power' THEN 'Moc czynna P [W]' WHEN 'reactive_power' THEN 'Moc bierna Q [var]' WHEN 'apparent_power' THEN 'Moc pozorna S [VA]' WHEN 'power_factor' THEN 'PF' ELSE 'Częstotliwość f [Hz]' END AS \"Wielkość\", last(value, time) AS \"Ostatnia\", min(value) AS \"Min\", max(value) AS \"Maks\", avg(value) AS \"Średnia\" FROM measurements WHERE $__timeFilter(time) AND device_id = '$device' AND metric IN ('voltage','current','active_power','reactive_power','apparent_power','power_factor','frequency') GROUP BY metric ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Wartości w oknie",
      "type": "table"
    },
