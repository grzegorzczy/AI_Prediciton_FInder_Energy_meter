  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aip-timescaledb"
      },
      "description": "Stan licznika uwzględniający łącze z PLC (K3-U3): „Brak danych z PLC”, gdy link_status ≠ 0 albo ostatni wpis link_status jest starszy niż próg ze zmiennej „Dane uznane za stare po”; „Brak danych z licznika”, gdy ostatni meter_status jest starszy niż ten próg; w pozostałych przypadkach nazwa stanu z docs/status-codes.md.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "Licznik działa"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "Licznik: błąd komunikacji"
                },
                "10": {
                  "color": "purple",
                  "index": 3,
                  "text": "Błąd konfiguracji: inny licznik niż w konfiguracji"
                },
                "100": {
                  "color": "red",
                  "index": 4,
                  "text": "Brak danych z PLC"
                },
                "101": {
                  "color": "orange",
                  "index": 5,
                  "text": "Brak danych z licznika"
                },
                "2": {
                  "color": "orange",
                  "index": 2,
                  "text": "Licznik: brak danych (start PLC)"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": ""
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aip-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "WITH l AS (SELECT time, value FROM measurements WHERE device_id = (SELECT device_id FROM devices WHERE kind = 'plc' ORDER BY device_id LIMIT 1) AND metric = 'link_status' AND time > now() - interval '1 hour' ORDER BY time DESC LIMIT 1), m AS (SELECT time, value FROM measurements WHERE device_id = '$device' AND metric = 'meter_status' AND time > now() - interval '1 hour' ORDER BY time DESC LIMIT 1) SELECT now() AS time, CASE WHEN l.time IS NULL OR now() - l.time > make_interval(secs => $stale_s) OR l.value <> 0 THEN 100 WHEN m.time IS NULL OR now() - m.time > make_interval(secs => $stale_s) THEN 101 ELSE m.value END AS \"Stan licznika\" FROM (SELECT 1) x LEFT JOIN l ON true LEFT JOIN m ON true",
          "refId": "A"
        }
      ],
      "title": "Stan licznika",
      "type": "stat"
    },
